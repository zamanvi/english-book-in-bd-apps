<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <!-- Result badge -->
        <androidx.cardview.widget.CardView
            android:id="@+id/resultBadgeCV"
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:cardBackgroundColor="@color/bg_elevated"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp">
            <TextView
                android:id="@+id/resultBadgeTV"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="?"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />
        </androidx.cardview.widget.CardView>

        <!-- Names + score -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/battleOpponentTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="প্রতিপক্ষ"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/battleScoreTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- Status -->
        <TextView
            android:id="@+id/battleStatusTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="অপেক্ষায়"
            android:textColor="@color/text_inactive"
            android:textSize="11sp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
