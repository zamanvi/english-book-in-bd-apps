<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep"
    tools:context=".Activity.QuizActivity">

    <!-- ── Top bar ────────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Close / back -->
        <androidx.cardview.widget.CardView
            android:id="@+id/closeBtn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_close"
                android:contentDescription="Quiz বন্ধ করো"
                app:tint="@color/text_secondary" />
        </androidx.cardview.widget.CardView>

        <!-- Progress dots -->
        <LinearLayout
            android:id="@+id/progressDots"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp" />

        <!-- XP badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_indigo_pill"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:src="@drawable/ic_bolt"
                android:contentDescription="XP"
                app:tint="@color/indigo"
                android:layout_marginEnd="3dp" />

            <TextView
                android:id="@+id/xpCountTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 XP"
                android:textColor="@color/indigo"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginStart="3dp"
                tools:ignore="HardcodedText" />

        </LinearLayout>

    </LinearLayout>

    <!-- ── Timer bar (thin, full width) ──────────────────────── -->
    <ProgressBar
        android:id="@+id/timerBar"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:progressDrawable="@drawable/progress_bar_timer"
        android:max="100"
        android:progress="100"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── Timer number + question number ────────────────────── -->
    <LinearLayout
        android:id="@+id/timerRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="4dp"
        app:layout_constraintTop_toBottomOf="@id/timerBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/questionNumberTV"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Question 1 of 10"
            android:textColor="@color/text_inactive"
            android:textSize="11sp"
            tools:ignore="HardcodedText" />

        <!-- Countdown -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:src="@drawable/ic_timer"
                android:contentDescription="সময়"
                app:tint="@color/text_inactive"
                android:layout_marginEnd="3dp" />

            <TextView
                android:id="@+id/timerTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15"
                android:textColor="@color/gold"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="s"
                android:textSize="11sp"
                android:textColor="@color/text_inactive" />

        </LinearLayout>

    </LinearLayout>

    <!-- ── Question card ─────────────────────────────────────── -->
    <androidx.cardview.widget.CardView
        android:id="@+id/questionCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="10dp"
        android:minHeight="80dp"
        app:cardBackgroundColor="#00000000"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/timerRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/optionsContainer"
        app:layout_constraintVertical_chainStyle="spread">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            android:background="@drawable/grad_word_of_day">

            <!-- Category label -->
            <TextView
                android:id="@+id/questionCategoryTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VOCABULARY"
                android:textColor="@color/indigo"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="14dp"
                tools:ignore="HardcodedText" />

            <!-- Question text -->
            <TextView
                android:id="@+id/questionTV"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="What does &quot;Eloquent&quot; mean?"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:lineSpacingMultiplier="1.3"
                tools:ignore="HardcodedText" />

            <!-- Bengali instruction hint -->
            <TextView
                android:id="@+id/questionHintTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="সঠিক উত্তরটি বেছে নাও"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:layout_marginTop="10dp"
                android:visibility="visible"
                tools:ignore="HardcodedText" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- ── MCQ options ────────────────────────────────────────── -->
    <LinearLayout
        android:id="@+id/optionsContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toTopOf="@id/bottomActionRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Option A — purple -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/optionA"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:layout_marginBottom="6dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="#1E1060"
            app:strokeColor="#8B7FFF"
            app:strokeWidth="1.5dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp">
                <TextView
                    android:id="@+id/labelA"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:text="A"
                    android:textColor="#1A1060"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@drawable/option_label_a" />
                <TextView
                    android:id="@+id/optionATV"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="Fluent and persuasive speaker"
                    android:textColor="#C4BEFF"
                    android:textSize="13sp"
                    android:maxLines="3"
                    android:ellipsize="end"
                    tools:ignore="HardcodedText" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Option B — blue -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/optionB"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:layout_marginBottom="6dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="#0A1E30"
            app:strokeColor="#38BDF8"
            app:strokeWidth="1.5dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp">
                <TextView
                    android:id="@+id/labelB"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:text="B"
                    android:textColor="#0A1830"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@drawable/option_label_b" />
                <TextView
                    android:id="@+id/optionBTV"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="Shy and introverted"
                    android:textColor="#7DD3FC"
                    android:textSize="13sp"
                    android:maxLines="3"
                    android:ellipsize="end"
                    tools:ignore="HardcodedText" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Option C — amber -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/optionC"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:layout_marginBottom="6dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="#1E1400"
            app:strokeColor="#FBBF24"
            app:strokeWidth="1.5dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp">
                <TextView
                    android:id="@+id/labelC"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:text="C"
                    android:textColor="#1E1000"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@drawable/option_label_c" />
                <TextView
                    android:id="@+id/optionCTV"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="Angry and aggressive"
                    android:textColor="#FDE68A"
                    android:textSize="13sp"
                    android:maxLines="3"
                    android:ellipsize="end"
                    tools:ignore="HardcodedText" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Option D — pink -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/optionD"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="#1E0A18"
            app:strokeColor="#F472B6"
            app:strokeWidth="1.5dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp">
                <TextView
                    android:id="@+id/labelD"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:text="D"
                    android:textColor="#1E0A18"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@drawable/option_label_d" />
                <TextView
                    android:id="@+id/optionDTV"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="Confusing and unclear"
                    android:textColor="#FBCFE8"
                    android:textSize="13sp"
                    android:maxLines="3"
                    android:ellipsize="end"
                    tools:ignore="HardcodedText" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- ── Bottom: feedback + next button ────────────────────── -->
    <LinearLayout
        android:id="@+id/bottomActionRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Answer feedback strip (hidden until answer chosen) -->
        <LinearLayout
            android:id="@+id/feedbackStrip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_teal_pill"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/feedbackIconTV"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:gravity="center"
                android:textSize="16sp"
                android:textStyle="bold"
                android:text="✓" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:id="@+id/feedbackTitleTV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="সঠিক! 🎉"
                    android:textColor="@color/teal"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/feedbackDetailTV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Eloquent means fluent and persuasive"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

            <TextView
                android:id="@+id/xpEarnedTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+1 XP"
                android:textColor="@color/teal"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

        </LinearLayout>

        <!-- Next button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/nextBtn"
            style="@style/btn_primary"
            android:text="পরবর্তী →"
            android:visibility="gone"
            tools:ignore="HardcodedText" />

    </LinearLayout>

    <!-- Loading overlay — shown while fetching quiz from server -->
    <ProgressBar
        android:id="@+id/quizLoadingBar"
        style="?android:attr/progressBarStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminateTint="@color/indigo"
        android:visibility="visible"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>
