<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/bg_deep">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="উচ্চারণের গতি বেছে নাও"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:ignore="HardcodedText" />

    <RadioGroup
        android:id="@+id/radioGroupVoiceSpeed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:ignore="UselessParent">

        <RadioButton
            android:id="@+id/radioSlower"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="অনেক ধীরে"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            tools:ignore="HardcodedText" />

        <RadioButton
            tools:ignore="HardcodedText"
            android:id="@+id/radioSlow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="ধীরে"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <RadioButton
            tools:ignore="HardcodedText"
            android:id="@+id/radioNormal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="স্বাভাবিক"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <RadioButton
            tools:ignore="HardcodedText"
            android:id="@+id/radioFast"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="দ্রুত"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <RadioButton
            tools:ignore="HardcodedText"
            android:id="@+id/radioFaster"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="অনেক দ্রুত"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

    </RadioGroup>
</LinearLayout>