<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep"
    android:scrollbars="none"
    android:fillViewport="true"
    tools:context=".Activity.LoginActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top gradient accent bar -->
        <View
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:background="@drawable/grad_stat_xp" />

        <!-- Hero area -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="@dimen/page_padding_horizontal"
            android:paddingEnd="@dimen/page_padding_horizontal"
            android:paddingTop="48dp"
            android:paddingBottom="40dp">

            <!-- App icon -->
            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/graduation"
                app:tint="@color/indigo"
                android:layout_marginBottom="16dp"
                android:contentDescription="App logo" />

            <!-- App name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Master English Book"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"
                tools:ignore="HardcodedText" />

            <!-- Tagline -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="শেখো, বাড়াও, জয় করো"
                android:textColor="@color/text_inactive"
                android:textSize="13sp"
                android:layout_marginBottom="36dp"
                tools:ignore="HardcodedText" />

            <!-- Form card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/grad_word_of_day"
                android:padding="20dp">

                <!-- Card header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="স্বাগতম! 👋"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="20dp"
                    tools:ignore="HardcodedText" />

                <!-- Name input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="তোমার নাম"
                    android:layout_marginBottom="14dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxStrokeColor="@color/bg_active"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:hintTextColor="@color/text_muted">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/loginNameET"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        android:imeOptions="actionNext"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:backgroundTint="@android:color/transparent" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Password input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="পাসওয়ার্ড"
                    android:layout_marginBottom="8dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxStrokeColor="@color/bg_active"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:hintTextColor="@color/text_muted"
                    app:passwordToggleEnabled="true">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/loginPasswordET"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:imeOptions="actionDone"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:backgroundTint="@android:color/transparent" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Error message -->
                <TextView
                    android:id="@+id/loginErrorTV"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/coral"
                    android:textSize="12sp"
                    android:visibility="gone"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp"
                    tools:ignore="HardcodedText" />

                <!-- Login button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/loginBtn"
                    style="@style/btn_primary"
                    android:layout_marginTop="8dp"
                    android:text="লগইন করো"
                    tools:ignore="HardcodedText" />

                <!-- Forgot password -->
                <TextView
                    android:id="@+id/forgotPasswordTV"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="পাসওয়ার্ড ভুলে গেছো?"
                    android:textColor="@color/gold"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:paddingTop="10dp"
                    android:paddingBottom="2dp"
                    tools:ignore="HardcodedText" />

                <!-- Go to register -->
                <TextView
                    android:id="@+id/goToRegisterTV"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="নতুন? একাউন্ট তৈরি করো →"
                    android:textColor="@color/indigo"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:paddingTop="10dp"
                    android:paddingBottom="4dp"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
