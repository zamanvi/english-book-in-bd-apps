<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".Activity.BookActivity">

    <include layout="@layout/lyt_toolbar" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="30dp"
            android:text="বইটি সংগ্রহ করতে"
            android:textColor="@color/main_theme_color"
            android:textSize="25sp"
            android:layout_marginBottom="50dp"
            tools:ignore="HardcodedText" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center">

            <ImageView
                android:id="@+id/callIB"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:contentDescription="call"
                android:padding="5dp"
                android:scaleType="fitXY"
                android:src="@drawable/ic_call"
                tools:ignore="HardcodedText" />

            <ImageView
                android:id="@+id/whatsappIB"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:contentDescription="whatsapp"
                android:scaleType="fitXY"
                android:src="@drawable/ic_whatsapp"
                tools:ignore="HardcodedText" />

            <ImageView
                android:id="@+id/facebookIB"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:contentDescription="facebook"
                android:padding="5dp"
                android:scaleType="fitXY"
                android:src="@drawable/facebook"
                tools:ignore="HardcodedText" />

            <ImageView
                android:id="@+id/youtubeIB"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:contentDescription="youtube"
                android:padding="5dp"
                android:scaleType="fitXY"
                android:src="@drawable/youtube"
                tools:ignore="HardcodedText" />

        </LinearLayout>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/banner_ad_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"/>

</LinearLayout>