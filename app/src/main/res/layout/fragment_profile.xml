<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep"
    android:scrollbars="none"
    tools:context=".fragment.ProfileFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/page_padding_bottom">

        <!-- ══════════════════════════════════════════════════════ -->
        <!-- Hero header card — avatar + name + level badge        -->
        <!-- ══════════════════════════════════════════════════════ -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_padding_horizontal"
            android:layout_marginEnd="@dimen/page_padding_horizontal"
            android:layout_marginTop="@dimen/page_padding_top"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#00000000"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingTop="28dp"
                android:paddingBottom="24dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="@drawable/grad_word_of_day">

                <!-- Avatar circle with indigo ring -->
                <FrameLayout
                    android:layout_width="84dp"
                    android:layout_height="84dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        app:cardBackgroundColor="@color/indigo_dim"
                        app:cardCornerRadius="42dp"
                        app:cardElevation="0dp">
                        <TextView
                            android:id="@+id/profileAvatarTV"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="👤"
                            android:textSize="36sp"
                            android:gravity="center" />

                        <ImageView
                            android:id="@+id/profileAvatarIV"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:visibility="gone"
                            android:contentDescription="" />
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/profileAvatarEditBtn"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_gravity="bottom|end"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        app:cardBackgroundColor="@color/indigo"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="2dp">
                        <ImageView
                            android:layout_width="15dp"
                            android:layout_height="15dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_camera"
                            android:contentDescription="প্রোফাইল ছবি পরিবর্তন করো"
                            app:tint="@color/white" />
                    </androidx.cardview.widget.CardView>
                </FrameLayout>

                <!-- Logged-in info block: name, user ID, level, XP progress -->
                <LinearLayout
                    android:id="@+id/loggedInInfoLL"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <!-- Name -->
                    <TextView
                        android:id="@+id/profileNameTV"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your Name"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.01"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_marginTop="14dp"
                        tools:ignore="HardcodedText" />

                    <!-- Friend Code — tap to copy; used for both battle challenges and Lipto gifting -->
                    <LinearLayout
                        android:id="@+id/profileFriendCodeTV"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:visibility="gone"
                        android:background="@drawable/bg_pill_inactive">

                        <TextView
                            android:id="@+id/profileFriendCodeText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Friend Code: —"
                            android:textColor="@color/gold"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace"
                            tools:ignore="HardcodedText" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="  📋 কপি করো"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp"
                            tools:ignore="HardcodedText" />

                    </LinearLayout>

                    <!-- Level badge chip -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:cardBackgroundColor="@color/indigo_dim"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp">
                        <TextView
                            android:id="@+id/profileLevelTV"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ইংরেজি শিক্ষার্থী"
                            android:textColor="@color/indigo"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp"
                            tools:ignore="HardcodedText" />
                    </androidx.cardview.widget.CardView>

                    <!-- XP progress to next level -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="14dp"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="6dp">
                            <TextView
                                android:id="@+id/profileLevelLabelTV"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Level 1"
                                android:textColor="@color/indigo"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                tools:ignore="HardcodedText" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text=""
                                android:textSize="11sp" />
                            <TextView
                                android:id="@+id/profileXpToNextTV"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="পরের level-এ যেতে আরও XP দরকার"
                                android:textColor="@color/text_inactive"
                                android:textSize="10sp"
                                tools:ignore="HardcodedText" />
                        </LinearLayout>
                        <ProgressBar
                            android:id="@+id/profileLevelProgressBar"
                            style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="5dp"
                            android:progressDrawable="@drawable/progress_bar_indigo"
                            android:max="100"
                            android:progress="0" />
                    </LinearLayout>

                </LinearLayout>

                <!-- Guest account-opening CTA (visible only when logged out) -->
                <LinearLayout
                    android:id="@+id/guestAccountCtaLL"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginTop="14dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="একটা ফ্রি Account খোলো"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="তোমার progress, Lipto আর streak সেভ রাখতে"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:gravity="center"
                        tools:ignore="HardcodedText" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/guestCtaBtn"
                        style="@style/btn_primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Account খোলো / Login করো"
                        tools:ignore="HardcodedText" />

                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ══════════════════════════════════════════════════════ -->
        <!-- Stats row: XP / Streak / Rank                        -->
        <!-- ══════════════════════════════════════════════════════ -->
        <LinearLayout
            android:id="@+id/statsRowLL"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="@dimen/page_padding_horizontal"
            android:paddingEnd="@dimen/page_padding_horizontal"
            android:layout_marginBottom="16dp">

            <!-- XP card -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                app:cardBackgroundColor="#00000000"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingTop="16dp"
                    android:paddingBottom="14dp"
                    android:background="@drawable/grad_stat_xp">
                    <!-- Accent top line -->
                    <View
                        android:layout_width="28dp"
                        android:layout_height="3dp"
                        android:background="@color/indigo"
                        android:layout_marginBottom="10dp" />
                    <TextView
                        android:id="@+id/profileXpTV"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/indigo"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚡ XP"
                        android:textColor="@color/text_inactive"
                        android:textSize="10sp"
                        android:letterSpacing="0.05"
                        android:layout_marginTop="2dp"
                        tools:ignore="HardcodedText" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Streak card -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                app:cardBackgroundColor="#00000000"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingTop="16dp"
                    android:paddingBottom="14dp"
                    android:background="@drawable/grad_stat_streak">
                    <View
                        android:layout_width="28dp"
                        android:layout_height="3dp"
                        android:background="@color/coral"
                        android:layout_marginBottom="10dp" />
                    <TextView
                        android:id="@+id/profileStreakTV"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/coral"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔥 Days"
                        android:textColor="@color/text_inactive"
                        android:textSize="10sp"
                        android:letterSpacing="0.05"
                        android:layout_marginTop="2dp"
                        tools:ignore="HardcodedText" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Rank card -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                app:cardBackgroundColor="#00000000"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingTop="16dp"
                    android:paddingBottom="14dp"
                    android:background="@drawable/grad_stat_rank">
                    <View
                        android:layout_width="28dp"
                        android:layout_height="3dp"
                        android:background="@color/gold"
                        android:layout_marginBottom="10dp" />
                    <TextView
                        android:id="@+id/profileRankTV"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/gold"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏅 Rank"
                        android:textColor="@color/text_inactive"
                        android:textSize="10sp"
                        android:letterSpacing="0.05"
                        android:layout_marginTop="2dp"
                        tools:ignore="HardcodedText" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- ══════════════════════════════════════════════════════ -->
        <!-- Lipto balance banner                                  -->
        <!-- ══════════════════════════════════════════════════════ -->
        <androidx.cardview.widget.CardView
            android:id="@+id/liptoBannerCV"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_padding_horizontal"
            android:layout_marginEnd="@dimen/page_padding_horizontal"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/teal_dim"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💎"
                    android:textSize="22sp"
                    android:layout_marginEnd="12dp"
                    tools:ignore="HardcodedText" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lipto ব্যালেন্স"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:letterSpacing="0.05"
                        tools:ignore="HardcodedText" />
                    <TextView
                        android:id="@+id/profileLiptoTV"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/teal"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quiz দিলে Lipto পাবে →"
                    android:textColor="@color/text_inactive"
                    android:textSize="10sp"
                    tools:ignore="HardcodedText" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ══════════════════════════════════════════════════════ -->
        <!-- Lipto tier badge + progress ring toward next tier      -->
        <!-- ══════════════════════════════════════════════════════ -->
        <androidx.cardview.widget.CardView
            android:id="@+id/liptoTierCV"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_padding_horizontal"
            android:layout_marginEnd="@dimen/page_padding_horizontal"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <FrameLayout
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="16dp">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/liptoTierProgressCPI"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:indeterminate="false"
                        app:trackThickness="5dp"
                        app:indicatorSize="56dp"
                        app:trackColor="@color/bg_stroke"
                        app:indicatorColor="@color/gold"
                        app:trackCornerRadius="4dp" />

                    <TextView
                        android:id="@+id/liptoTierEmojiTV"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="🥉"
                        android:textSize="22sp"
                        tools:ignore="HardcodedText" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/liptoTierNameTV"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bronze Tier"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />
                    <TextView
                        android:id="@+id/liptoTierProgressTV"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp"
                        tools:ignore="HardcodedText" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ══════════════════════════════════════════════════════ -->
        <!-- 7-day streak calendar                                 -->
        <!-- ══════════════════════════════════════════════════════ -->
        <androidx.cardview.widget.CardView
            android:id="@+id/streakCalendarCV"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_padding_horizontal"
            android:layout_marginEnd="@dimen/page_padding_horizontal"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="এই সপ্তাহ"
                        android:textColor="@color/text_inactive"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.10"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:id="@+id/weekStreakLabelTV"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="০ / ৭ দিন"
                        android:textColor="@color/coral"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/weekDaysRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Invite: shares the user's own friend code (logged-in only; see ProfileFragment) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/menuInviteCV"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_padding_horizontal"
            android:layout_marginEnd="@dimen/page_padding_horizontal"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            android:visibility="gone"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎁"
                    android:textSize="24sp"
                    tools:ignore="HardcodedText" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="বন্ধুকে ডাকো"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="কেউ তোমার কোড দিয়ে যোগ দিলে তুমি ৫০ Lipto পাবে (দিনে ১০ জন পর্যন্ত)"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp"
                        tools:ignore="HardcodedText" />
                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_arrow_right"
                    android:contentDescription=""
                    app:tint="@color/text_muted" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Everything that used to be 8 menu rows here now lives in SettingsActivity -->
        <androidx.cardview.widget.CardView
            android:id="@+id/menuSettingsCV"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_padding_horizontal"
            android:layout_marginEnd="@dimen/page_padding_horizontal"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚙️"
                    android:textSize="24sp"
                    tools:ignore="HardcodedText" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="10dp">

                    <TextView
