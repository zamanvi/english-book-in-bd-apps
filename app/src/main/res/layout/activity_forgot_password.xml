<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Activity.ForgotPasswordActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_deep"
        android:scrollbars="none"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top accent bar -->
        <View
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:background="@drawable/grad_stat_xp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="48dp"
            android:paddingBottom="40dp">

            <!-- Icon -->
            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/graduation"
                app:tint="@color/gold"
                android:layout_marginBottom="16dp"
                android:contentDescription="Key" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="পাসওয়ার্ড ভুলে গেছো?"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"
                tools:ignore="HardcodedText" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Email-এ OTP দিয়ে পাসওয়ার্ড রিসেট করো"
                android:textColor="@color/text_inactive"
                android:textSize="13sp"
                android:gravity="center"
                android:layout_marginBottom="36dp"
                tools:ignore="HardcodedText" />

            <!-- Form card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/grad_word_of_day"
                android:padding="20dp">

                <!-- Error / success message -->
                <TextView
                    android:id="@+id/forgotErrorTV"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/red_wrong"
                    android:textSize="13sp"
                    android:background="@drawable/bg_error_banner"
                    android:padding="12dp"
                    android:visibility="gone"
                    android:layout_marginBottom="12dp"
                    tools:ignore="HardcodedText" />

                <!-- ===== STEP 1: Email ===== -->
                <LinearLayout
                    android:id="@+id/step1Layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ধাপ ১: Email দাও"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="18dp"
                        tools:ignore="HardcodedText" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="তোমার Email address"
                        android:layout_marginBottom="8dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        app:boxStrokeColor="@color/edittext_stroke_color"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:hintTextColor="@color/edittext_hint_color">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/forgotEmailET"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textEmailAddress"
                            android:imeOptions="actionDone"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_muted"
                            android:backgroundTint="@android:color/transparent" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/sendOtpBtn"
                        style="@style/btn_primary"
                        android:layout_marginTop="8dp"
                        android:text="OTP পাঠাও"
                        tools:ignore="HardcodedText" />

                </LinearLayout>

                <!-- ===== STEP 2: OTP verify ===== -->
                <LinearLayout
                    android:id="@+id/step2Layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ধাপ ২: OTP যাচাই"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="তোমার Email inbox চেক করো। ৬ সংখ্যার OTP দাও।"
                        android:textColor="@color/text_muted"
                        android:textSize="12sp"
                        android:layout_marginBottom="16dp"
                        tools:ignore="HardcodedText" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="৬ সংখ্যার OTP"
                        android:layout_marginBottom="8dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        app:boxStrokeColor="@color/edittext_stroke_color"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:hintTextColor="@color/edittext_hint_color">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/forgotOtpET"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLength="6"
                            android:imeOptions="actionDone"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_muted"
                            android:backgroundTint="@android:color/transparent" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/verifyOtpBtn"
                        style="@style/btn_primary"
                        android:layout_marginTop="8dp"
                        android:text="যাচাই করো"
                        tools:ignore="HardcodedText" />

                </LinearLayout>

                <!-- ===== STEP 3: New password ===== -->
                <LinearLayout
                    android:id="@+id/step3Layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ধাপ ৩: নতুন পাসওয়ার্ড"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="18dp"
                        tools:ignore="HardcodedText" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="নতুন পাসওয়ার্ড (কমপক্ষে ৬ অক্ষর)"
                        android:layout_marginBottom="14dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        app:boxStrokeColor="@color/edittext_stroke_color"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:hintTextColor="@color/edittext_hint_color"
                        app:passwordToggleEnabled="true">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/newPasswordET"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:imeOptions="actionNext"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_muted"
                            android:backgroundTint="@android:color/transparent" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="আবার পাসওয়ার্ড দাও"
                        android:layout_marginBottom="8dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        app:boxStrokeColor="@color/edittext_stroke_color"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:hintTextColor="@color/edittext_hint_color"
                        app:passwordToggleEnabled="true">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/confirmNewPasswordET"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:imeOptions="actionDone"
                            android:textColor="@color/text_primary"
                            android:textColorHint="@color/text_muted"
                            android:backgroundTint="@android:color/transparent" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/resetPasswordBtn"
                        style="@style/btn_primary"
                        android:layout_marginTop="8dp"
                        android:text="পাসওয়ার্ড পরিবর্তন করো"
                        tools:ignore="HardcodedText" />

                </LinearLayout>

                <!-- Back to login -->
                <TextView
                    android:id="@+id/forgotBackTV"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="← লগইন পেজে ফিরে যাও"
                    android:textColor="@color/indigo"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:paddingTop="16dp"
                    android:paddingBottom="4dp"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
    </ScrollView>

    <!-- Close - so the auth flow is never a dead end -->
    <androidx.cardview.widget.CardView
        android:id="@+id/closeBtn"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/bg_card"
        app:cardCornerRadius="10dp"
        app:cardElevation="4dp">
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_close"
            android:contentDescription="বন্ধ করো"
            app:tint="@color/text_secondary" />
    </androidx.cardview.widget.CardView>
</FrameLayout>
