<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep"
    tools:context=".Activity.WordActivity">

    <include layout="@layout/lyt_toolbar"/>

    <!-- ── Column header row ─────────────────────────────────── -->
    <!-- Structure mirrors lyt_item_word.xml exactly (26dp counter + 10dp gap +
         weight="3" word/meaning cell + 1dp divider + weight="2" verb/syn-ant
         cell) so header labels stay pixel-aligned with the cells beneath
         them, and scale the same way across screen widths. -->
    <androidx.cardview.widget.CardView
        android:id="@+id/headerCV"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_padding_horizontal"
        android:layout_marginEnd="@dimen/page_padding_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="@color/bg_elevated"
        app:cardCornerRadius="14dp"
        app:cardElevation="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:gravity="center_vertical">

            <!-- # counter -->
            <TextView
                android:id="@+id/counterTvW"
                android:layout_width="26dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="#"
                android:textColor="@color/teal"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                tools:ignore="HardcodedText" />

            <!-- Word + Meaning block (mirrors the inline word/meaning cell) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:layout_marginStart="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/wordCloseIV"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_eye_closed"
                    android:contentDescription="@string/app_name"
                    app:tint="@color/text_inactive" />

                <TextView
                    android:id="@+id/wordTvW"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Word"
                    android:textAllCaps="true"
                    android:letterSpacing="0.02"
                    android:textColor="@color/text_inactive"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    tools:ignore="HardcodedText" />

                <ImageView
                    android:id="@+id/meaningCloseIV"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="10dp"
                    android:src="@drawable/ic_eye_closed"
                    android:contentDescription="@string/app_name"
                    app:tint="@color/text_inactive" />

                <TextView
                    android:id="@+id/meaningTvW"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Meaning"
                    android:textAllCaps="true"
                    android:letterSpacing="0.02"
                    android:textColor="@color/text_inactive"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="22dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:background="@color/text_inactive" />

            <!-- Synonym + Antonym block (mirrors the stacked verb/syn-ant cell) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:orientation="vertical"
                android:gravity="start">

                <TextView
                    android:id="@+id/synonymsTvW"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Syn."
                    android:textAllCaps="true"
                    android:letterSpacing="0.02"
                    android:textColor="@color/teal"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/antonymsTvW"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Ant."
                    android:textAllCaps="true"
                    android:letterSpacing="0.02"
                    android:textColor="@color/red_wrong"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/wordRV"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="4dp"
        android:clipToPadding="false" />

</LinearLayout>
