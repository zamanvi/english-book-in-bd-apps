<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep"
    tools:context=".Activity.WordActivity">

    <include layout="@layout/lyt_toolbar"/>

    <!-- ── Column header row ─────────────────────────────────── -->
    <!-- Structure mirrors lyt_item_word.xml exactly (32dp counter + 10dp gap +
         two weight="1" blocks) so header labels stay pixel-aligned with the
         word/meaning and synonym/antonym cells beneath them regardless of
         text length. -->
    <androidx.cardview.widget.CardView
        android:id="@+id/headerCV"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_padding_horizontal"
        android:layout_marginEnd="@dimen/page_padding_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="4dp"
        app:cardBackgroundColor="@color/bg_elevated"
        app:cardCornerRadius="14dp"
        app:cardElevation="3dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:gravity="center_vertical">

            <!-- # counter -->
            <TextView
                android:id="@+id/counterTvW"
                android:layout_width="32dp"
                android:layout_height="wrap_content"
                android:text="#"
                android:textColor="@color/gold"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <!-- Word + Meaning block (mirrors the stacked word/meaning cell) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/wordCloseIV"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_eye_closed"
                        android:contentDescription="@string/app_name"
                        app:tint="@color/text_inactive" />

                    <TextView
                        android:id="@+id/wordTvW"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text="Word"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/meaningCloseIV"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_eye_closed"
                        android:contentDescription="@string/app_name"
                        app:tint="@color/text_inactive" />

                    <TextView
                        android:id="@+id/meaningTvW"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text="Meaning"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />

                </LinearLayout>

            </LinearLayout>

            <!-- Synonym + Antonym block (mirrors the stacked, right-aligned cell) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:id="@+id/synonymsTvW"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Syn."
                    android:textColor="@color/teal"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/antonymsTvW"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Ant."
                    android:textColor="@color/red_wrong"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/wordRV"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="4dp"
        android:clipToPadding="false" />

</LinearLayout>
