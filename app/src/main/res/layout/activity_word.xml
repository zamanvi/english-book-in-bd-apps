<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep"
    tools:context=".Activity.WordActivity">

    <include layout="@layout/lyt_toolbar"/>

    <!-- Lesson title lives here, not in the Toolbar itself - AppCompat's
         Toolbar sizes its bar around a single-line title internally, so a
         long wrapped title placed inside it gets clipped instead of pushing
         the bar taller. A plain TextView in the normal layout flow wraps
         exactly like any other multi-line text. -->
    <TextView
        android:id="@+id/lessonTitleTV"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_padding_horizontal"
        android:layout_marginEnd="@dimen/page_padding_horizontal"
        android:layout_marginTop="8dp"
        android:text="Lesson title"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_size_body"
        android:fontFamily="sans-serif-medium"
        android:lineSpacingExtra="2dp"
        android:maxLines="2"
        android:ellipsize="end"
        tools:ignore="HardcodedText" />

    <!-- ── Column header row ─────────────────────────────────── -->
    <!-- Structure mirrors lyt_item_word.xml exactly (26dp counter + 10dp gap +
         weight="3" word/meaning cell + 1dp divider + weight="2" verb/syn-ant
         cell) so header labels stay pixel-aligned with the cells beneath
         them, and scale the same way across screen widths. -->
    <androidx.cardview.widget.CardView
        android:id="@+id/headerCV"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_padding_horizontal"
        android:layout_marginEnd="@dimen/page_padding_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="8dp"
        app:cardBackgroundColor="@color/bg_elevated"
        app:cardCornerRadius="14dp"
        app:cardElevation="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:gravity="center_vertical">

            <!-- # counter -->
            <TextView
                android:id="@+id/counterTvW"
                android:layout_width="26dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="#"
                android:textColor="@color/teal"
                android:textSize="@dimen/text_size_label"
                android:fontFamily="sans-serif-medium"
                tools:ignore="HardcodedText" />

            <!-- Word + Meaning block - split into two equal-weight halves so
                 the labels line up with the actual word/meaning columns below
                 (lyt_item_word.xml splits wordTV/meaningTV 50/50 the same way;
                 previously this was one un-split row so both labels sat
                 bunched at the left instead of tracking the columns). -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:layout_marginStart="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/wordCloseIV"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_eye_closed"
                        android:contentDescription="@string/app_name"
                        app:tint="@color/text_inactive" />

                    <TextView
                        android:id="@+id/wordTvW"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="Word"
                        android:textAllCaps="true"
                        android:letterSpacing="0.02"
                        android:textColor="@color/text_inactive"
                        android:textSize="@dimen/text_size_label"
                        android:fontFamily="sans-serif-medium"
                        tools:ignore="HardcodedText" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/meaningCloseIV"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_eye_closed"
                        android:contentDescription="@string/app_name"
                        app:tint="@color/text_inactive" />

                    <TextView
                        android:id="@+id/meaningTvW"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="Meaning"
                        android:textAllCaps="true"
                        android:letterSpacing="0.02"
                        android:textColor="@color/text_inactive"
                        android:textSize="@dimen/text_size_label"
                        android:fontFamily="sans-serif-medium"
                        tools:ignore="HardcodedText" />

                </LinearLayout>

            </LinearLayout>

            <View
                android:id="@+id/headerDividerV"
                android:layout_width="1dp"
                android:layout_height="22dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:background="@color/text_inactive" />

            <!-- Synonym + Antonym block (mirrors the stacked verb/syn-ant cell) -->
            <LinearLayout
                android:id="@+id/headerSynAntLL"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:orientation="vertical"
                android:gravity="start">

                <TextView
                    android:id="@+id/synonymsTvW"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Syn."
                    android:textAllCaps="true"
                    android:letterSpacing="0.02"
                    android:textColor="@color/teal"
                    android:textSize="@dimen/text_size_label"
                    android:fontFamily="sans-serif-medium"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/antonymsTvW"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Ant."
                    android:textAllCaps="true"
                    android:letterSpacing="0.02"
                    android:textColor="@color/red_wrong"
                    android:textSize="@dimen/text_size_label"
                    android:fontFamily="sans-serif-medium"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Quiz entry point for an unlocked Premium lesson - the lesson-list's
         own quiz shortcut is hidden for all Premium rows (no way to tell
         locked from unlocked there), so unlocked users need this instead. -->
    <androidx.cardview.widget.CardView
        android:id="@+id/takeQuizBtnCV"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/indigo_dim"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        tools:visibility="visible">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:text="⚡ পুরো লেসনে কুইজ দাও"
            android:textColor="@color/indigo"
            android:textSize="@dimen/text_size_label"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />
    </androidx.cardview.widget.CardView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/wordRV"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingTop="4dp"
            android:paddingBottom="150dp"
            android:clipToPadding="false" />

        <!-- Shown when a free (or already-unlocked) lesson genuinely has no
             words yet - otherwise the list is just a blank area forever with
             no explanation. -->
        <LinearLayout
            android:id="@+id/wordEmptyLL"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:padding="24dp"
            tools:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📭"
                android:textSize="36sp"
                android:layout_marginBottom="10dp"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/wordEmptyTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="এই লেসনে এখনো কোনো শব্দ যোগ করা হয়নি"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/text_size_body_secondary"
                android:gravity="center"
                tools:ignore="HardcodedText" />

        </LinearLayout>

        <!-- Premium unlock card - shown when this lesson is a locked premium lesson -->
        <androidx.cardview.widget.CardView
            android:id="@+id/unlockCardCV"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_margin="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/bg_elevated"
            app:cardCornerRadius="18dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👑"
                    android:textSize="28sp"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/unlockTitleTV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="আরও শব্দ লক করা আছে"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_body"
                    android:textStyle="bold"
                    android:gravity="center"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/unlockSubTV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="সম্পূর্ণ লেসন আনলক করে সব শব্দ দেখো"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_size_label"
                    android:gravity="center"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/unlockErrorTV"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/red_wrong"
                    android:textSize="@dimen/text_size_label"
                    android:gravity="center"
                    android:visibility="gone"
                    tools:ignore="HardcodedText" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/unlockBtn"
                    style="@style/btn_primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="🔒 50 💎 দিয়ে আনলক করো"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Guest nudge card - shown only to logged-out users on a Free lesson -->
        <include layout="@layout/lyt_guest_lipto_nudge" />

    </FrameLayout>

</LinearLayout>
