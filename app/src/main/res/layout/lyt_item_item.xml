<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootCV"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="@dimen/page_padding_horizontal"
    android:layout_marginRight="@dimen/page_padding_horizontal"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/bg_elevated"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <View
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="12dp"
            android:background="@color/indigo"
            android:minHeight="40dp" />

        <TextView
            android:id="@+id/titleTV"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Lorem ipsum dolor sit amet,"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:maxLines="2"
            android:ellipsize="end"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/premiumBadgeTV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="👑"
            android:textSize="16sp"
            android:visibility="gone"
            tools:ignore="HardcodedText" />

        <!-- Quick-start a quiz on this lesson directly, without going through
             the Home "Quick Quiz" picker flow. Hidden when the row itself is
             already acting as a quiz picker (its own click does this). -->
        <androidx.cardview.widget.CardView
            android:id="@+id/quickQuizBtnCV"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/indigo_dim"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp">
            <TextView
                android:id="@+id/quickQuizBtnTV"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:text="⚡ কুইজ"
                android:textColor="@color/indigo"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />
        </androidx.cardview.widget.CardView>

    </LinearLayout>

</androidx.cardview.widget.CardView>