<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_deep"
    android:scrollbars="none"
    android:fillViewport="true"
    tools:context=".Activity.RegisterActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top gradient accent bar -->
        <View
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:background="@drawable/grad_stat_xp" />

        <!-- Hero + form -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="48dp"
            android:paddingBottom="40dp">

            <!-- App icon -->
            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/graduation"
                app:tint="@color/indigo"
                android:layout_marginBottom="16dp"
                android:contentDescription="App logo" />

            <!-- Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="নতুন একাউন্ট"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"
                tools:ignore="HardcodedText" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="মাত্র কয়েক সেকেন্ড লাগবে"
                android:textColor="@color/text_inactive"
                android:textSize="13sp"
                android:layout_marginBottom="36dp"
                tools:ignore="HardcodedText" />

            <!-- Form card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/grad_word_of_day"
                android:padding="20dp">

                <!-- Card header -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="একাউন্ট তৈরি করো 🎉"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="20dp"
                    tools:ignore="HardcodedText" />

                <!-- Name -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="তোমার নাম লিখো"
                    android:layout_marginBottom="14dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxStrokeColor="@color/bg_active"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:hintTextColor="@color/text_muted">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/registerNameET"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        android:imeOptions="actionNext"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:backgroundTint="@android:color/transparent" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Password -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="পাসওয়ার্ড দাও (কমপক্ষে ৬ অক্ষর)"
                    android:layout_marginBottom="14dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxStrokeColor="@color/bg_active"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:hintTextColor="@color/text_muted"
                    app:passwordToggleEnabled="true">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/registerPasswordET"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:imeOptions="actionNext"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:backgroundTint="@android:color/transparent" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Confirm Password -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="আবার পাসওয়ার্ড দাও"
                    android:layout_marginBottom="14dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxStrokeColor="@color/bg_active"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:hintTextColor="@color/text_muted"
                    app:passwordToggleEnabled="true">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/registerConfirmPasswordET"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:imeOptions="actionNext"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:backgroundTint="@android:color/transparent" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Email hint -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📧 পাসওয়ার্ড ভুললে এই email-এ OTP যাবে"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp"
                    tools:ignore="HardcodedText" />

                <!-- Email -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Email address"
                    android:layout_marginBottom="8dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    app:boxStrokeColor="@color/bg_active"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:hintTextColor="@color/text_muted">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/registerEmailET"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:imeOptions="actionDone"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:backgroundTint="@android:color/transparent" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Error -->
                <TextView
                    android:id="@+id/registerErrorTV"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/coral"
                    android:textSize="12sp"
                    android:visibility="gone"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp"
                    tools:ignore="HardcodedText" />

                <!-- Register button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/registerBtn"
                    style="@style/btn_primary"
                    android:layout_marginTop="8dp"
                    android:text="একাউন্ট তৈরি করো"
                    tools:ignore="HardcodedText" />

                <!-- Go to login -->
                <TextView
                    android:id="@+id/goToLoginTV"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="আগে থেকে একাউন্ট আছে? লগইন করো ←"
                    android:textColor="@color/indigo"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:paddingTop="14dp"
                    android:paddingBottom="4dp"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
