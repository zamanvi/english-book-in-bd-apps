<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.Library" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/indigo</item>
        <item name="colorPrimaryVariant">@color/indigo_deep</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/gold</item>
        <item name="colorSecondaryVariant">@color/indigo</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:windowBackground">@color/bg_deep</item>
        <item name="android:statusBarColor">@color/bg_deep</item>
        <item name="android:navigationBarColor">@color/bg_deep</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="colorPrimaryDark">@color/bg_deep</item>
        <item name="colorAccent">@color/indigo</item>
        <item name="android:splitMotionEvents">false</item>
        <item name="android:windowEnableSplitTouch">false</item>
        <item name="android:windowContentTransitions">true</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_inactive</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="fontFamily">@font/poppins</item>
        <item name="actionOverflowMenuStyle">@style/OverflowMenuDark</item>
        <item name="popupMenuStyle">@style/OverflowMenuDark</item>
        <item name="colorSurface">@color/bg_elevated</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="colorControlNormal">@color/text_muted</item>
        <item name="colorControlActivated">@color/indigo</item>
    </style>

    <style name="Theme.Library" parent="Base.Theme.Library" />

    <!-- Toolbar overflow / PopupMenu default to the Light-theme's own white
         popup background; since android:textColor is overridden light-on-dark
         above for the rest of the app, that left overflow menu items
         rendering white text on the default white popup (invisible). -->
    <style name="OverflowMenuDark" parent="Widget.MaterialComponents.PopupMenu.Overflow">
        <item name="android:popupBackground">@color/bg_elevated</item>
    </style>

    <style name="listCard" parent="Theme.Library">
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:layout_marginEnd">16dp</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="android:focusable">true</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/bg_card</item>
    </style>

    <!-- Button: primary indigo -->
    <style name="btn_primary" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:backgroundTint">@color/indigo</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">13dp</item>
    </style>

    <!-- Button: ghost outline -->
    <style name="btn_outline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:backgroundTint">@android:color/transparent</item>
        <item name="android:textColor">@color/indigo</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">13dp</item>
        <item name="strokeColor">@color/indigo</item>
        <item name="strokeWidth">1dp</item>
    </style>

</resources>
